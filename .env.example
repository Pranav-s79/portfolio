# ---------------------------------------------------------------
# Frontend (Vite) - must be prefixed VITE_ and are PUBLIC in the bundle.
# ---------------------------------------------------------------

# Leave unset in production: the form posts to the same-origin /api/contact.
# Only set this if the API is hosted on a different domain.
# VITE_CONTACT_API_URL=https://example.com/api/contact

# Cloudflare Turnstile SITE key (public). Get it at:
# https://dash.cloudflare.com/?to=/:account/turnstile
# If unset, the CAPTCHA widget is not rendered.
VITE_TURNSTILE_SITE_KEY=

# Only needed when deploying to a GitHub Pages *project* site subpath.
# Vercel/custom domains should leave this unset (defaults to '/').
# VITE_BASE_PATH=/portfolio/

# ---------------------------------------------------------------
# Backend (Vercel serverless) - SECRET. Set in the Vercel dashboard,
# never commit real values.
# ---------------------------------------------------------------

# Resend API key for delivery: https://resend.com/api-keys
RESEND_API_KEY=

# Where contact messages are delivered.
CONTACT_TO_EMAIL=pranav.senthilkumar79@gmail.com

# Verified Resend sender. Until a custom domain is verified, the shared
# sandbox sender below works but only delivers to your own account email.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Comma-separated allowlist of browser origins permitted to POST.
# Set this in production; unset means any origin is accepted.
CONTACT_ALLOWED_ORIGIN=https://your-domain.com

# Cloudflare Turnstile SECRET key (pairs with VITE_TURNSTILE_SITE_KEY).
# If unset, CAPTCHA verification is skipped.
TURNSTILE_SECRET_KEY=

# Upstash Redis for rate limiting (3/hour, 10/day per IP).
# Create a free database at https://console.upstash.com
# If unset, rate limiting is skipped (fails open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
